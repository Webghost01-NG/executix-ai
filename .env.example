# Executix AI Configuration Template
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/executix_db?schema=public"

# Blockchain RPC & Network Settings (Ethereum Sepolia Testnet)
NEXT_PUBLIC_ALCHEMY_RPC_URL="https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY_HERE"
NEXT_PUBLIC_CHAIN_ID="11155111"

# KeeperHub Official API Key
KEEPERHUB_API_KEY="YOUR_KEEPERHUB_API_KEY_HERE"

# Background Worker Daemon Polling Interval (ms)
WORKER_POLL_INTERVAL_MS="3000"

# Optional Server Signer Private Key
AGENT_PRIVATE_KEY="YOUR_AGENT_PRIVATE_KEY_HERE"
