# ==============================================================================
# Executix AI - Environment Configuration Template (.env.example)
# Copy this file to .env.local and fill in your keys:
#   cp .env.example .env.local
# ==============================================================================

# 1. PostgreSQL Database URL (Created automatically by running `docker compose up -d postgres`)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/executix_db?schema=public"

# 2. Alchemy RPC Node URL for Ethereum Sepolia Testnet
# Get key free at: https://dashboard.alchemy.com (Create App -> Network: Sepolia)
NEXT_PUBLIC_ALCHEMY_RPC_URL="https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY"

# 3. KeeperHub Official Execution API Key
# Get key at: https://keeperhub.com (Developer Dashboard -> API Keys)
KEEPERHUB_API_KEY="kh_live_YOUR_KEEPERHUB_API_KEY"

# 4. Agent Worker Private Key for Onchain Transaction Signing
# Export from MetaMask / Rabby -> Account Details -> Export Private Key (Sepolia)
AGENT_PRIVATE_KEY="0xYOUR_SEPOLIA_WALLET_PRIVATE_KEY"

# 5. Target Network Chain ID (11155111 = Ethereum Sepolia Testnet)
NEXT_PUBLIC_CHAIN_ID="11155111"

# 6. Background Worker Polling Interval (in milliseconds)
WORKER_POLL_INTERVAL_MS="3000"
